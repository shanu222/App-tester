# TesterBridge environment
# Copy to .env.local and fill in real values. Never commit secrets.

# --- App ---
APP_URL="http://localhost:3000"
# Production (Vercel) is pinned in code to https://www.testloop.org.
# Also set AUTH_URL to that origin so Auth.js does not inherit the request host.
AUTH_URL="http://localhost:3000"
AUTH_SECRET=""
NODE_ENV="development"

# DEMO_MODE uses mock adapters and isolated demo records.
# Production must be "false" and requires real integration credentials.
DEMO_MODE="true"

# --- Database (PostgreSQL) ---
# On Vercel/Neon: DATABASE_URL = pooled, DIRECT_URL = unpooled (required for migrations).
DATABASE_URL="postgresql://testerbridge:testerbridge@localhost:5432/testerbridge?schema=public"
DIRECT_URL="postgresql://testerbridge:testerbridge@localhost:5432/testerbridge?schema=public"

# --- Encryption for stored OAuth tokens / service-account JSON ---
# 64 hex chars = 32 bytes. Generate: openssl rand -hex 32
ENCRYPTION_KEY=""

# --- Cron ---
CRON_SECRET="replace-with-random-cron-secret"

# Optional: email used for the single workspace user (no login).
DEFAULT_USER_EMAIL="owner@local"

# --- Facebook / Meta (optional, Pages you manage) ---
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/integrations/facebook/callback"
FACEBOOK_GRAPH_VERSION="v21.0"

# --- Google Sign-In (Auth.js) + optional Gmail send ---
# Use the SAME existing OAuth Web client. Do not create a new client.
# Authorized JavaScript origin (production): https://www.testloop.org
# Authorized redirect URI (production login): https://www.testloop.org/api/auth/callback/google
# Optional Gmail send callback: https://www.testloop.org/api/integrations/gmail/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Google Play Developer API (service account JSON, base64 or file path) ---
# Prefer per-user encrypted upload in Integrations. These are optional platform defaults.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""
GOOGLE_CLOUD_PROJECT=""

# --- Google Workspace Admin SDK / Cloud Identity (optional group automation) ---
GOOGLE_WORKSPACE_ADMIN_EMAIL=""
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_JSON=""

# --- System email (optional) ---
RESEND_API_KEY=""
EMAIL_FROM="TesterBridge <noreply@localhost>"
