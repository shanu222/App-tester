# TesterBridge environment
# Copy to .env.local and fill in real values. Never commit secrets.

# --- App ---
APP_URL="http://localhost:3000"
# Do not set AUTH_URL / NEXTAUTH_URL in Vercel production. Auth.js must use the
# request hostname so sessions work on testloop.org, www.testloop.org, and
# app-tester-three.vercel.app.
AUTH_TRUST_HOST="true"
AUTH_SECRET=""
NODE_ENV="development"

# DEMO_MODE uses mock adapters and isolated demo records.
# Production must be "false" and requires real integration credentials.
DEMO_MODE="true"

# --- Database (PostgreSQL) ---
# On Vercel/Neon: DATABASE_URL = pooled, DIRECT_URL = unpooled (required for migrations).
DATABASE_URL="postgresql://testerbridge:testerbridge@localhost:5432/testerbridge?schema=public"
DIRECT_URL="postgresql://testerbridge:testerbridge@localhost:5432/testerbridge?schema=public"

# --- Encryption for stored OAuth tokens / service-account JSON ---
# 64 hex chars = 32 bytes. Generate: openssl rand -hex 32
ENCRYPTION_KEY=""

# --- Cron ---
# Required in production. Vercel Cron sends Authorization: Bearer $CRON_SECRET.
# Generate a cryptographically secure value (do not use a predictable string):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vercel → Project → Settings → Environment Variables → CRON_SECRET
# Never put this in NEXT_PUBLIC_* or commit the real value.
CRON_SECRET=""

# Optional: email used for the single workspace user (no login).
DEFAULT_USER_EMAIL="owner@local"

# --- Facebook / Meta (optional, Pages you manage) ---
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/integrations/facebook/callback"
FACEBOOK_GRAPH_VERSION="v21.0"

# --- Google Cloud OAuth: Gmail sending + Play API only. NOT used for login. ---
# Login goes through Firebase Authentication (see below). No /api/auth/callback/google
# redirect URI is needed any more.
# The Gmail send callback uses the request origin + /api/integrations/gmail/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Firebase Authentication: the ONLY way users sign in ---
# Covers both "Continue with Google" and email/password. Required for login to work.
# Firebase Console → Project settings → Your apps → Web app config.
# These are public by design; Firebase restricts access by Authorized domains.
# Enable Google and Email/Password under Firebase Console → Authentication → Sign-in method,
# and add www.testloop.org and app-tester-three.vercel.app under
# Firebase Console → Authentication → Settings → Authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Defaults to <projectId>.firebaseapp.com when empty.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""

# --- Google Play Developer API ---
# Each developer connects their own Play Console on /play, either with Google
# OAuth (uses GOOGLE_CLIENT_ID/SECRET above) or by uploading a service account
# key. Per-developer credentials are encrypted with ENCRYPTION_KEY and stored
# server-side only. Never expose any of this through NEXT_PUBLIC_*.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""
GOOGLE_CLOUD_PROJECT=""

# --- System email (SMTP) ---
# Already configured on Vercel production. Do not rename, remove, or expose.
# Never put these in NEXT_PUBLIC_* or return them from APIs.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="TestLoop"

# Optional legacy Resend fallback (unused when SMTP is configured)
RESEND_API_KEY=""
EMAIL_FROM="TesterBridge <noreply@localhost>"
